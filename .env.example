# Copy this file to .env and fill in your real keys.
# The pipeline loads these via python-dotenv if you add
# `from dotenv import load_dotenv; load_dotenv()` — or just export them
# in your shell before running, whichever you prefer.

# Google Places API (New) — enable "Places API (New)" in Google Cloud Console,
# NOT the older "Places API". Required for Stage 1 firm sourcing.
GOOGLE_PLACES_API_KEY=

EXA_API_KEY=
ANTHROPIC_API_KEY=
