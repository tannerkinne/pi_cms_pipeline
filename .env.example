# Copy this file to .env and fill in your real keys.
# The pipeline loads these via python-dotenv if you add
# `from dotenv import load_dotenv; load_dotenv()` — or just export them
# in your shell before running, whichever you prefer.

# Google Places API (New) — enable "Places API (New)" in Google Cloud Console,
# NOT the older "Places API". Required for Stage 1 firm sourcing.
GOOGLE_PLACES_API_KEY=

EXA_API_KEY=
ANTHROPIC_API_KEY=

# Apollo.io — used in Stage 3 for decision-maker lookup AND verified email
# enrichment (POST /api/v1/people/match). Optional: if unset, Stage 3 still runs
# but skips Apollo entirely and leaves decision_maker_email blank.
APOLLO_API_KEY=

# Optional — only needed for the Google Sheets export (Stage 5 / --to-sheets).
# Path to a Google service-account JSON key, and the target spreadsheet id
# (the long token in the sheet URL: docs.google.com/spreadsheets/d/<ID>/edit).
# See requirements-sheets.txt for setup.
GOOGLE_SHEETS_CREDENTIALS_FILE=
GOOGLE_SHEET_ID=
